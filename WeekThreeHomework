trigger LeadTrigger on Lead (after insert, after update) {
    if (trigger.isInsert){
        if (trigger.isAfter){
            LeadTriggerHandler.handleAfterInsert(Trigger.new);
        }
    } else if (trigger.isUpdate){
        if (trigger.isAfter) {
            LeadTriggerHandler.handleAfterUpdate(trigger.new, trigger.oldMap);
        }
    }
}
