public with sharing class LeadTriggerHandler {
    public static void handleAfterInsert(List<Lead> newLeads) { 
        
        List<Task> tasksToInsert = new List<Task>();

        for (Lead leadRecord : newLeads) {

            if (leadRecord.Product_Interest__c != null) {

                Task newTask = new Task();

                newTask.Subject = 'Follow up - ' + leadRecord.Product_Interest__c;
                newTask.WhoId = leadRecord.Id;
                newTask.Status = 'Not Started';
                newTask.Priority = 'Normal';

                tasksToInsert.add(newTask);
            }
        }

        if (!tasksToInsert.isEmpty()) {
            insert tasksToInsert;
        }
    }

    public static void handleAfterUpdate(List<Lead> newLeads, Map<Id, Lead> oldLeadMap) {

        List<Task> tasksToInsert = new List<Task>();

        for (Lead leadRecord : newLeads) {

            Lead oldLead = oldLeadMap.get(leadRecord.Id);

            // Only create a task if Product Interest changed
            if (leadRecord.Product_Interest__c != oldLead.Product_Interest__c
                && leadRecord.Product_Interest__c != null) {

                Task newTask = new Task();

                newTask.Subject = 'Follow up - ' + leadRecord.Product_Interest__c;
                newTask.WhoId = leadRecord.Id;
                newTask.Status = 'Not Started';
                newTask.Priority = 'Normal';

                tasksToInsert.add(newTask);
            }
        }

        if (!tasksToInsert.isEmpty()) {
            insert tasksToInsert;
        }
    }
}
